#!/bin/sh
# Safety net for `git push`: rejects the push if any outgoing commit's
# message doesn't follow "KILO-<number>: <message>". This catches commits
# made with --no-verify that skipped the commit-msg hook.
#
# Installed via: git config core.hooksPath .githooks

pattern='^KILO-[0-9]+: .+'
remote_name="$1"
bad=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  for subject_line in $(git log --pretty=%H "$range" 2>/dev/null); do
    subject=$(git log -1 --pretty=%s "$subject_line")
    case "$subject" in
      "Merge "*) continue ;;
    esac
    if ! echo "$subject" | grep -qE "$pattern"; then
      echo "ERROR: push rejected - commit $subject_line has a bad message:"
      echo "  $subject"
      echo "Expected format: KILO-<number>: <message>"
      bad=1
    fi
  done
done

[ "$bad" -eq 1 ] && exit 1
exit 0
